@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="text-center py-5">
    <i class="bi bi-exclamation-triangle" style="font-size: 3rem; color: #ef4444;"></i>
    <h2 class="mt-3" style="color: var(--text-primary);">An error occurred</h2>
    <p style="color: var(--text-secondary);">An error occurred while processing your request.</p>

    @if (Model.ShowRequestId)
    {
        <p style="color: var(--text-secondary);">
            <strong style="color: var(--text-primary);">Request ID:</strong> <code>@Model.RequestId</code>
        </p>
    }
</div>
