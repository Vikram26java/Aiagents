@model AppUser
@{
    ViewData["Title"] = "Settings";
    var activeTab = ViewBag.ActiveTab as string ?? "appearance";
    var userInitial = Model.FullName?.Length > 0 ? Model.FullName[0].ToString().ToUpper() : "?";
}

<h4 class="mb-4">Settings</h4>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-1"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-circle me-1"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    <!-- Left Nav -->
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-2">
                <nav class="settings-nav nav flex-column">
                    <a class="nav-link @(activeTab == "appearance" ? "active" : "")" href="/Settings?tab=appearance">
                        <i class="bi bi-palette"></i> Appearance
                    </a>
                    <a class="nav-link @(activeTab == "account" ? "active" : "")" href="/Settings?tab=account">
                        <i class="bi bi-shield-lock"></i> Account & Security
                    </a>
                    <a class="nav-link @(activeTab == "privacy" ? "active" : "")" href="/Settings?tab=privacy">
                        <i class="bi bi-eye-slash"></i> Privacy
                    </a>
                    <a class="nav-link @(activeTab == "updates" ? "active" : "")" href="/Settings?tab=updates">
                        <i class="bi bi-bell"></i> Updates
                    </a>
                    <a class="nav-link @(activeTab == "language" ? "active" : "")" href="/Settings?tab=language">
                        <i class="bi bi-translate"></i> Language
                    </a>
                </nav>
            </div>
        </div>
    </div>

    <!-- Right Content -->
    <div class="col-md-9">
        <!-- Appearance Tab -->
        <div id="tab-appearance" style="display: @(activeTab == "appearance" ? "block" : "none");">
            <div class="card border-0 shadow-sm">
                <div class="card-header"><i class="bi bi-palette me-2"></i>Appearance</div>
                <div class="card-body">
                    <h6 class="mb-3" style="color: var(--text-primary);">Theme</h6>
                    <p style="color: var(--text-secondary);">Choose how the app looks to you. Select a light or dark theme.</p>
                    <div class="row g-3 mt-2">
                        <div class="col-md-6">
                            <div class="card card-hover-lift theme-option" data-theme-select="light" style="cursor: pointer;">
                                <div class="card-body text-center p-4">
                                    <i class="bi bi-sun-fill fs-1" style="color: #f59e0b;"></i>
                                    <h6 class="mt-2 mb-1" style="color: var(--text-primary);">Light Mode</h6>
                                    <small style="color: var(--text-secondary);">Clean and bright interface</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card card-hover-lift theme-option" data-theme-select="dark" style="cursor: pointer;">
                                <div class="card-body text-center p-4">
                                    <i class="bi bi-moon-fill fs-1" style="color: #818cf8;"></i>
                                    <h6 class="mt-2 mb-1" style="color: var(--text-primary);">Dark Mode</h6>
                                    <small style="color: var(--text-secondary);">Easy on the eyes</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Account & Security Tab -->
        <div id="tab-account" style="display: @(activeTab == "account" ? "block" : "none");">
            <!-- Avatar Section -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header"><i class="bi bi-person-circle me-2"></i>Profile Picture</div>
                <div class="card-body">
                    <div class="d-flex align-items-center gap-4 mb-4">
                        @if (!string.IsNullOrEmpty(Model.ProfileImageUrl))
                        {
                            <div class="avatar avatar-xl"><img src="@Model.ProfileImageUrl" alt="@Model.FullName" /></div>
                        }
                        else
                        {
                            <div class="avatar avatar-xl avatar-initials">@userInitial</div>
                        }
                        <div>
                            <h6 class="mb-1" style="color: var(--text-primary);">@Model.FullName</h6>
                            <small style="color: var(--text-secondary);">@Model.Email</small>
                        </div>
                    </div>
                    <form asp-action="UploadAvatar" method="post" enctype="multipart/form-data" id="avatarForm">
                        @Html.AntiForgeryToken()
                        <div class="avatar-upload-area" id="avatarDropZone">
                            <i class="bi bi-cloud-arrow-up fs-2" style="color: var(--text-muted);"></i>
                            <p class="mb-1 mt-2" style="color: var(--text-secondary);">Drag and drop an image, or click to browse</p>
                            <small style="color: var(--text-muted);">JPEG, PNG, GIF, WebP. Max 5MB.</small>
                            <input type="file" name="avatar" id="avatarInput" accept="image/*" style="display: none;" />
                        </div>
                        <div class="mt-3 d-flex gap-2">
                            <button type="submit" class="btn btn-primary btn-sm" id="uploadBtn" style="display: none;">
                                <i class="bi bi-upload me-1"></i> Upload
                            </button>
                            @if (!string.IsNullOrEmpty(Model.ProfileImageUrl))
                            {
                                <form asp-action="RemoveAvatar" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger btn-sm">
                                        <i class="bi bi-trash me-1"></i> Remove
                                    </button>
                                </form>
                            }
                        </div>
                    </form>
                </div>
            </div>

            <!-- Account Info -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header"><i class="bi bi-info-circle me-2"></i>Account Information</div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Full Name</label>
                            <input type="text" class="form-control" value="@Model.FullName" disabled />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Email</label>
                            <input type="email" class="form-control" value="@Model.Email" disabled />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Phone</label>
                            <input type="text" class="form-control" value="@(Model.PhoneNumber ?? "Not set")" disabled />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Member Since</label>
                            <input type="text" class="form-control" value="@Model.CreatedAt.ToString("MMMM dd, yyyy")" disabled />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Change Password -->
            <div class="card border-0 shadow-sm">
                <div class="card-header"><i class="bi bi-key me-2"></i>Change Password</div>
                <div class="card-body">
                    <form asp-action="ChangePassword" method="post" style="max-width: 400px;">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label">Current Password</label>
                            <input type="password" name="currentPassword" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">New Password</label>
                            <input type="password" name="newPassword" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Confirm New Password</label>
                            <input type="password" name="confirmPassword" class="form-control" required />
                        </div>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i> Update Password
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Privacy Tab -->
        <div id="tab-privacy" style="display: @(activeTab == "privacy" ? "block" : "none");">
            <div class="card border-0 shadow-sm">
                <div class="card-header"><i class="bi bi-eye-slash me-2"></i>Privacy</div>
                <div class="card-body">
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-1" style="color: var(--text-primary);">Profile Visibility</h6>
                                <small style="color: var(--text-secondary);">Allow other members to see your profile</small>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input privacy-toggle" type="checkbox" id="profileVisibility" data-key="privacy_profile_visible" checked />
                            </div>
                        </div>
                    </div>
                    <hr />
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-1" style="color: var(--text-primary);">Activity Status</h6>
                                <small style="color: var(--text-secondary);">Show when you are online</small>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input privacy-toggle" type="checkbox" id="activityStatus" data-key="privacy_activity_status" checked />
                            </div>
                        </div>
                    </div>
                    <hr />
                    <div>
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-1" style="color: var(--text-primary);">Data Sharing</h6>
                                <small style="color: var(--text-secondary);">Share usage data to help improve the platform</small>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input privacy-toggle" type="checkbox" id="dataSharing" data-key="privacy_data_sharing" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Updates Tab -->
        <div id="tab-updates" style="display: @(activeTab == "updates" ? "block" : "none");">
            <div class="card border-0 shadow-sm">
                <div class="card-header"><i class="bi bi-bell me-2"></i>Notification Preferences</div>
                <div class="card-body">
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-1" style="color: var(--text-primary);">Email Notifications</h6>
                                <small style="color: var(--text-secondary);">Receive email notifications for new messages</small>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input updates-toggle" type="checkbox" id="emailNotifications" data-key="updates_email" checked />
                            </div>
                        </div>
                    </div>
                    <hr />
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-1" style="color: var(--text-primary);">Security Alerts</h6>
                                <small style="color: var(--text-secondary);">Get notified about security events on your account</small>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input updates-toggle" type="checkbox" id="securityAlerts" data-key="updates_security" checked />
                            </div>
                        </div>
                    </div>
                    <hr />
                    <div>
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-1" style="color: var(--text-primary);">Product Updates</h6>
                                <small style="color: var(--text-secondary);">Receive updates about new features and improvements</small>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input updates-toggle" type="checkbox" id="productUpdates" data-key="updates_product" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Language Tab -->
        <div id="tab-language" style="display: @(activeTab == "language" ? "block" : "none");">
            <div class="card border-0 shadow-sm">
                <div class="card-header"><i class="bi bi-translate me-2"></i>Language</div>
                <div class="card-body">
                    <p style="color: var(--text-secondary);">Select your preferred language for the interface.</p>
                    <div style="max-width: 400px;">
                        <select class="form-select" id="languageSelect">
                            <option value="en" selected>English</option>
                            <option value="es">Espa&ntilde;ol (Spanish)</option>
                            <option value="fr">Fran&ccedil;ais (French)</option>
                            <option value="de">Deutsch (German)</option>
                            <option value="pt">Portugu&ecirc;s (Portuguese)</option>
                            <option value="zh">&#20013;&#25991; (Chinese)</option>
                            <option value="ja">&#26085;&#26412;&#35486; (Japanese)</option>
                            <option value="ko">&#54620;&#44397;&#50612; (Korean)</option>
                            <option value="ar">&#1575;&#1604;&#1593;&#1585;&#1576;&#1610;&#1577; (Arabic)</option>
                            <option value="hi">&#2361;&#2367;&#2344;&#2381;&#2342;&#2368; (Hindi)</option>
                        </select>
                        <small class="mt-2 d-block" style="color: var(--text-muted);">Language preference is saved locally in your browser.</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Theme selection cards
    document.querySelectorAll('.theme-option').forEach(card => {
        card.addEventListener('click', function() {
            const theme = this.dataset.themeSelect;
            document.documentElement.setAttribute('data-theme', theme);
            localStorage.setItem('theme', theme);
            highlightThemeCard(theme);
            // Update icon in navbar
            const icon = document.getElementById('themeIcon');
            if (icon) icon.className = theme === 'dark' ? 'bi bi-moon-fill' : 'bi bi-sun-fill';
        });
    });

    function highlightThemeCard(theme) {
        document.querySelectorAll('.theme-option').forEach(c => {
            c.style.borderColor = '';
            c.style.borderWidth = '';
        });
        const active = document.querySelector(`.theme-option[data-theme-select="${theme}"]`);
        if (active) {
            active.style.borderColor = 'var(--accent)';
            active.style.borderWidth = '2px';
        }
    }
    highlightThemeCard(document.documentElement.getAttribute('data-theme') || 'light');

    // Avatar upload drag & drop
    const dropZone = document.getElementById('avatarDropZone');
    const avatarInput = document.getElementById('avatarInput');
    const uploadBtn = document.getElementById('uploadBtn');

    if (dropZone && avatarInput) {
        dropZone.addEventListener('click', () => avatarInput.click());

        dropZone.addEventListener('dragover', (e) => {
            e.preventDefault();
            dropZone.style.borderColor = 'var(--accent)';
            dropZone.style.background = 'var(--accent-light)';
        });

        dropZone.addEventListener('dragleave', () => {
            dropZone.style.borderColor = '';
            dropZone.style.background = '';
        });

        dropZone.addEventListener('drop', (e) => {
            e.preventDefault();
            dropZone.style.borderColor = '';
            dropZone.style.background = '';
            if (e.dataTransfer.files.length > 0) {
                avatarInput.files = e.dataTransfer.files;
                showFileSelected(e.dataTransfer.files[0].name);
            }
        });

        avatarInput.addEventListener('change', () => {
            if (avatarInput.files.length > 0) {
                showFileSelected(avatarInput.files[0].name);
            }
        });

        function showFileSelected(name) {
            dropZone.innerHTML = `<i class="bi bi-check-circle fs-2" style="color: var(--accent);"></i><p class="mb-0 mt-2" style="color: var(--text-primary);">${name}</p>`;
            if (uploadBtn) uploadBtn.style.display = 'inline-block';
        }
    }

    // Privacy & Updates toggles (localStorage)
    document.querySelectorAll('.privacy-toggle, .updates-toggle').forEach(toggle => {
        const key = toggle.dataset.key;
        const stored = localStorage.getItem(key);
        if (stored !== null) toggle.checked = stored === 'true';
        toggle.addEventListener('change', () => {
            localStorage.setItem(key, toggle.checked);
        });
    });

    // Language selector (localStorage)
    const langSelect = document.getElementById('languageSelect');
    if (langSelect) {
        const storedLang = localStorage.getItem('preferred_language');
        if (storedLang) langSelect.value = storedLang;
        langSelect.addEventListener('change', () => {
            localStorage.setItem('preferred_language', langSelect.value);
        });
    }
</script>
}
