@{
    ViewData["Title"] = "Access Denied";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <div class="p-4 text-center">
        <i class="bi bi-shield-exclamation" style="font-size: 3rem; color: #ef4444;"></i>
        <h4 class="mt-3" style="color: var(--text-primary);">Access Denied</h4>
