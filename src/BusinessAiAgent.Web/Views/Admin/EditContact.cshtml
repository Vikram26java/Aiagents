@model Contact
@{
    ViewData["Title"] = "Edit Contact";
    var companies = (List<Company>)ViewBag.Companies;
}

<a href="/Admin/ContactDetail/@Model.Id" class="text-decoration-none"><i class="bi bi-arrow-left me-1"></i> Back</a>

<h4 class="mt-3 mb-4" style="color: var(--text-primary);">Edit Contact</h4>

<div class="card border-0 shadow-sm" style="max-width: 600px;">
    <div class="card-body">
        <form asp-action="EditContact" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label">Name</label>
                <input type="text" name="name" class="form-control" value="@Model.Name" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Email</label>
                <input type="email" name="email" class="form-control" value="@Model.Email" />
            </div>
            <div class="mb-3">
                <label class="form-label">Phone</label>
                <input type="tel" name="phone" class="form-control" value="@Model.Phone" />
            </div>
            <div class="mb-3">
                <label class="form-label">Company</label>
                <select name="companyId" class="form-select">
                    <option value="">— No company —</option>
                    @foreach (var c in companies)
                    {
                        <option value="@c.Id" selected="@(c.Id == Model.CompanyId)">@c.Name</option>
                    }
                </select>
            </div>
            <div class="btn-group-actions justify-content-start">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a href="/Admin/ContactDetail/@Model.Id" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
