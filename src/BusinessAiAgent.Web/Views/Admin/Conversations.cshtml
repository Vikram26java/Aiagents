@model List<Conversation>
@{
    ViewData["Title"] = "Conversations";
    var channelFilter = ViewBag.ChannelFilter as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0" style="color: var(--text-primary);">Conversations @(channelFilter != null ? $"— {channelFilter}" : "")</h4>
</div>

<div class="filter-pills mb-3">
    <a href="/Admin/Conversations" class="filter-pill @(channelFilter == null ? "active" : "")">All</a>
    <a href="/Admin/Conversations?channel=Chat" class="filter-pill @(channelFilter == "Chat" ? "active" : "")" style="text-decoration: none;">Chat</a>
    <a href="/Admin/Conversations?channel=Voice" class="filter-pill @(channelFilter == "Voice" ? "active" : "")" style="text-decoration: none;">Voice</a>
    <a href="/Admin/Conversations?channel=Sms" class="filter-pill @(channelFilter == "Sms" ? "active" : "")" style="text-decoration: none;">SMS</a>
    <a href="/Admin/Conversations?channel=Email" class="filter-pill @(channelFilter == "Email" ? "active" : "")" style="text-decoration: none;">Email</a>
    <a href="/Admin/Conversations?channel=Direct" class="filter-pill @(channelFilter == "Direct" ? "active" : "")" style="text-decoration: none;">Direct</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Channel</th>
                    <th>Subject</th>
                    <th>Contact</th>
                    <th>Messages</th>
                    <th>Created</th>
                    <th>Updated</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    var badge = c.Channel.ToString() switch
                    {
                        "Chat" => "bg-primary",
                        "Voice" => "bg-success",
                        "Sms" => "bg-warning",
                        "Email" => "bg-danger",
                        "Direct" => "bg-dark",
                        _ => "bg-secondary"
                    };
                    <tr>
                        <td><span class="badge @badge">@c.Channel</span></td>
                        <td style="color: var(--text-primary);">@c.Subject</td>
                        <td style="color: var(--text-secondary);">@(c.Contact?.Name ?? "—")</td>
                        <td style="color: var(--text-secondary);">@c.Messages.Count</td>
                        <td style="color: var(--text-secondary);">@c.CreatedAt.ToString("MMM dd, HH:mm")</td>
                        <td style="color: var(--text-secondary);">@(c.UpdatedAt?.ToString("MMM dd, HH:mm") ?? "—")</td>
                        <td>
                            <div class="btn-group-actions">
                                <a asp-action="ConversationDetail" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary">View</a>
                                <a asp-action="EditConversation" asp-route-id="@c.Id" class="btn btn-sm btn-outline-warning">Edit</a>
                                <form asp-action="DeleteConversation" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this conversation?')">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center py-4" style="color: var(--text-muted);">No conversations found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
