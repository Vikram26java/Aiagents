@model List<Company>
@{
    ViewData["Title"] = "Companies";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0" style="color: var(--text-primary);">Companies</h4>
    <a asp-action="CreateCompany" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> New Company</a>
</div>

<!-- Member Count Filter -->
<div class="filter-pills mb-3">
    <button class="filter-pill active" data-filter="all">All</button>
    <button class="filter-pill" data-filter="small">Small (1-5)</button>
    <button class="filter-pill" data-filter="medium">Medium (6-20)</button>
    <button class="filter-pill" data-filter="large">Large (20+)</button>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Address</th>
                    <th>Members</th>
                    <th>Created</th>
                    <th>Updated</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="companiesTable">
                @foreach (var c in Model)
                {
                    <tr data-members="@c.Contacts.Count">
                        <td><strong style="color: var(--text-primary);">@c.Name</strong></td>
                        <td style="color: var(--text-secondary);">@(c.Address ?? "—")</td>
                        <td>
                            <span class="badge" style="background: var(--accent-light); color: var(--accent);">
                                @c.Contacts.Count
                            </span>
                        </td>
                        <td style="color: var(--text-secondary);">@c.CreatedAt.ToString("MMM dd, yyyy")</td>
                        <td style="color: var(--text-secondary);">@(c.UpdatedAt?.ToString("MMM dd, yyyy") ?? "—")</td>
                        <td>
                            <div class="btn-group-actions">
                                <a asp-action="CompanyDetail" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary">View</a>
                                <a asp-action="EditCompany" asp-route-id="@c.Id" class="btn btn-sm btn-outline-warning">Edit</a>
                                <form asp-action="DeleteCompany" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this company?')">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center py-4" style="color: var(--text-muted);">No companies yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
    document.querySelectorAll('.filter-pill').forEach(btn => {
        btn.addEventListener('click', function() {
            document.querySelectorAll('.filter-pill').forEach(b => b.classList.remove('active'));
            this.classList.add('active');

            const filter = this.dataset.filter;
            const rows = document.querySelectorAll('#companiesTable tr[data-members]');

            rows.forEach(row => {
                const count = parseInt(row.dataset.members, 10);
                let show = true;
                if (filter === 'small') show = count >= 1 && count <= 5;
                else if (filter === 'medium') show = count >= 6 && count <= 20;
                else if (filter === 'large') show = count > 20;
                row.style.display = show ? '' : 'none';
            });
        });
    });
</script>
}
