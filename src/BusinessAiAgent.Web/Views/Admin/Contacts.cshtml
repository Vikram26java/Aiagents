@model List<Contact>
@{
    ViewData["Title"] = "Contacts";
    var search = ViewBag.Search as string;
}

<div class="page-header">
    <h4 class="mb-0" style="color: var(--text-primary);">Contacts</h4>
</div>

<form method="get" asp-action="Contacts" class="mb-3">
    <div class="input-group" style="max-width: 400px;">
        <input type="text" name="search" class="form-control" placeholder="Search contacts..." value="@search" />
        <button class="btn btn-outline-primary" type="submit"><i class="bi bi-search"></i></button>
        @if (!string.IsNullOrEmpty(search))
        {
            <a asp-action="Contacts" class="btn btn-outline-secondary">Clear</a>
        }
    </div>
</form>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Company</th>
                    <th>Conversations</th>
                    <th>Created</th>
                    <th>Updated</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    var initial = c.Name.Length > 0 ? c.Name[0].ToString().ToUpper() : "?";
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="avatar avatar-sm avatar-initials">@initial</div>
                                <strong style="color: var(--text-primary);">@c.Name</strong>
                            </div>
                        </td>
                        <td style="color: var(--text-secondary);">@(c.Email ?? "—")</td>
                        <td style="color: var(--text-secondary);">@(c.Phone ?? "—")</td>
                        <td style="color: var(--text-secondary);">@(c.Company?.Name ?? "—")</td>
                        <td style="color: var(--text-secondary);">@c.Conversations.Count</td>
                        <td style="color: var(--text-secondary);">@c.CreatedAt.ToString("MMM dd, yyyy")</td>
                        <td style="color: var(--text-secondary);">@(c.UpdatedAt?.ToString("MMM dd, yyyy") ?? "—")</td>
                        <td>
                            <div class="btn-group-actions">
                                <a asp-action="ContactDetail" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary">View</a>
                                <a asp-action="EditContact" asp-route-id="@c.Id" class="btn btn-sm btn-outline-warning">Edit</a>
                                <form asp-action="DeleteContact" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this contact?')">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="8" class="text-center py-4" style="color: var(--text-muted);">No contacts found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
