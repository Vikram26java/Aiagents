@model Company
@{
    ViewData["Title"] = "Edit Company";
}

<a href="/Admin/CompanyDetail/@Model.Id" class="text-decoration-none"><i class="bi bi-arrow-left me-1"></i> Back</a>

<h4 class="mt-3 mb-4" style="color: var(--text-primary);">Edit Company</h4>

<div class="card border-0 shadow-sm" style="max-width: 600px;">
    <div class="card-body">
        <form asp-action="EditCompany" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label">Name</label>
                <input type="text" name="name" class="form-control" value="@Model.Name" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Address</label>
                <input type="text" name="address" class="form-control" value="@Model.Address" />
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a href="/Admin/CompanyDetail/@Model.Id" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
