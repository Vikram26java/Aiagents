@{
    ViewData["Title"] = "Create Company";
}

<a href="/Admin/Companies" class="text-decoration-none"><i class="bi bi-arrow-left me-1"></i> Back</a>

<h4 class="mt-3 mb-4" style="color: var(--text-primary);">Create Company</h4>

<div class="card border-0 shadow-sm" style="max-width: 600px;">
    <div class="card-body">
        <form asp-action="CreateCompany" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label">Name</label>
                <input type="text" name="name" class="form-control" required autofocus />
            </div>
            <div class="mb-3">
                <label class="form-label">Address</label>
                <input type="text" name="address" class="form-control" />
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Create Company</button>
                <a href="/Admin/Companies" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
