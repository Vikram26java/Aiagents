@model Company
@{
    ViewData["Title"] = Model.Name;
}

<a href="/Admin/Companies" class="text-decoration-none"><i class="bi bi-arrow-left me-1"></i> Back to Companies</a>

<div class="row mt-3">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <div class="avatar avatar-xl avatar-initials mx-auto mb-3" style="background: rgba(234, 179, 8, 0.1); color: #eab308;">
                    <i class="bi bi-building" style="font-size: 1.6rem;"></i>
                </div>
                <h5 style="color: var(--text-primary);">@Model.Name</h5>
                @if (!string.IsNullOrEmpty(Model.Address))
                {
                    <p style="color: var(--text-secondary);">@Model.Address</p>
                }
                <hr />
                <div class="text-start">
                    <p style="color: var(--text-secondary);"><i class="bi bi-calendar me-2" style="color: var(--accent);"></i> Created @Model.CreatedAt.ToString("MMM dd, yyyy")</p>
                    @if (Model.UpdatedAt.HasValue)
                    {
                        <p style="color: var(--text-secondary);"><i class="bi bi-clock me-2" style="color: var(--accent);"></i> Updated @Model.UpdatedAt.Value.ToString("MMM dd, yyyy")</p>
                    }
                    <p style="color: var(--text-secondary);"><i class="bi bi-people me-2" style="color: var(--accent);"></i> @Model.Contacts.Count members</p>
                </div>
                <div class="mt-3 d-flex gap-2 justify-content-center">
                    <a asp-action="EditCompany" asp-route-id="@Model.Id" class="btn btn-warning btn-sm"><i class="bi bi-pencil"></i> Edit</a>
                    <form asp-action="DeleteCompany" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this company?')">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-danger btn-sm"><i class="bi bi-trash"></i> Delete</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header">Members</div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var contact in Model.Contacts)
                        {
                            var initial = contact.Name.Length > 0 ? contact.Name[0].ToString().ToUpper() : "?";
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar avatar-sm avatar-initials">@initial</div>
                                        <span style="color: var(--text-primary);">@contact.Name</span>
                                    </div>
                                </td>
                                <td style="color: var(--text-secondary);">@(contact.Email ?? "—")</td>
                                <td style="color: var(--text-secondary);">@(contact.Phone ?? "—")</td>
                                <td><a asp-action="ContactDetail" asp-route-id="@contact.Id" class="btn btn-sm btn-outline-primary">View</a></td>
                            </tr>
                        }
                        @if (!Model.Contacts.Any())
                        {
                            <tr><td colspan="4" class="text-center py-3" style="color: var(--text-muted);">No members yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
