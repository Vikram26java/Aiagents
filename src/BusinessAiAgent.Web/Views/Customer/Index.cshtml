@{
    ViewData["Title"] = "Dashboard";
    var totalConversations = (int)ViewBag.TotalConversations;
    var totalMessages = (int)ViewBag.TotalMessages;
    var recent = (List<Conversation>)ViewBag.RecentConversations;
}

<h4 class="mb-4" style="color: var(--text-primary);">My Dashboard</h4>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm card-hover-lift">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="stat-icon" style="background: rgba(99, 102, 241, 0.1); color: #6366f1;">
                        <i class="bi bi-chat-dots"></i>
                    </div>
                    <div class="ms-3">
                        <div class="stat-label">My Conversations</div>
                        <div class="stat-value">@totalConversations</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm card-hover-lift">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="stat-icon" style="background: rgba(34, 197, 94, 0.1); color: #22c55e;">
                        <i class="bi bi-chat-square-text"></i>
                    </div>
                    <div class="ms-3">
                        <div class="stat-label">My Messages</div>
                        <div class="stat-value">@totalMessages</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <a href="/Customer/Conversations" class="btn btn-primary w-100 mb-2"><i class="bi bi-chat-dots me-1"></i> View Conversations</a>
                <a href="/Customer/Chat" class="btn btn-outline-secondary w-100"><i class="bi bi-chat-heart me-1"></i> Direct Chat</a>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header">Recent Conversations</div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Channel</th>
                    <th>Subject</th>
                    <th>Messages</th>
                    <th>Created</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in recent)
                {
                    var badge = c.Channel.ToString() switch
                    {
                        "Chat" => "bg-primary",
                        "Voice" => "bg-success",
                        "Sms" => "bg-warning",
                        "Email" => "bg-danger",
                        "Direct" => "bg-dark",
                        _ => "bg-secondary"
                    };
                    <tr>
                        <td><span class="badge @badge">@c.Channel</span></td>
                        <td style="color: var(--text-primary);">@c.Subject</td>
                        <td style="color: var(--text-secondary);">@c.Messages.Count</td>
                        <td style="color: var(--text-secondary);">@c.CreatedAt.ToString("MMM dd, HH:mm")</td>
                        <td><a asp-action="ConversationDetail" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary">View</a></td>
                    </tr>
                }
                @if (!recent.Any())
                {
                    <tr><td colspan="5" class="text-center py-4" style="color: var(--text-muted);">No conversations yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
