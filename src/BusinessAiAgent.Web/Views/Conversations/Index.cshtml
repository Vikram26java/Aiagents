@using BusinessAiAgent.Core.Entities
@model List<Conversation>
@{
    ViewData["Title"] = "Conversations";
    var channelFilter = ViewBag.ChannelFilter as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0" style="color: var(--text-primary);">Conversations @(channelFilter != null ? $"— {channelFilter}" : "")</h4>
    <button class="btn btn-primary" id="btnNewChat"><i class="bi bi-plus-lg me-1"></i> New Chat</button>
</div>

<!-- Channel filter pills -->
<div class="filter-pills mb-3">
    <a href="/conversations" class="filter-pill @(channelFilter == null ? "active" : "")" style="text-decoration: none;">All</a>
    <a href="/conversations?channel=Chat" class="filter-pill @(channelFilter == "Chat" ? "active" : "")" style="text-decoration: none;">Chat</a>
    <a href="/conversations?channel=Voice" class="filter-pill @(channelFilter == "Voice" ? "active" : "")" style="text-decoration: none;">Voice</a>
    <a href="/conversations?channel=Sms" class="filter-pill @(channelFilter == "Sms" ? "active" : "")" style="text-decoration: none;">SMS</a>
    <a href="/conversations?channel=Email" class="filter-pill @(channelFilter == "Email" ? "active" : "")" style="text-decoration: none;">Email</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Channel</th>
                    <th>Subject</th>
                    <th>Contact</th>
                    <th>Messages</th>
                    <th>Created</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    var badge = c.Channel.ToString() switch
                    {
                        "Chat" => "bg-primary",
                        "Voice" => "bg-success",
                        "Sms" => "bg-warning",
                        "Email" => "bg-danger",
                        _ => "bg-secondary"
                    };
                    <tr>
                        <td><span class="badge @badge">@c.Channel</span></td>
                        <td style="color: var(--text-primary);">@c.Subject</td>
                        <td style="color: var(--text-secondary);">@(c.Contact?.Name ?? "—")</td>
                        <td style="color: var(--text-secondary);">@c.Messages.Count</td>
                        <td style="color: var(--text-secondary);">@c.CreatedAt.ToString("MMM dd, HH:mm")</td>
                        <td><a asp-action="Detail" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary">View</a></td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center py-4" style="color: var(--text-muted);">No conversations found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
    document.getElementById('btnNewChat').addEventListener('click', async () => {
        const res = await fetch('/api/chat/conversations', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ subject: 'New Chat' })
        });
        const data = await res.json();
        window.location.href = `/conversations/${data.id}`;
    });
</script>
}
