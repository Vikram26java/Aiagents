@using BusinessAiAgent.Core.Entities
@using BusinessAiAgent.Core.Enums
@model Conversation
@{
    ViewData["Title"] = Model.Subject;
}

<div class="page-header mb-3">
    <div>
        <a href="/conversations" class="text-decoration-none"><i class="bi bi-arrow-left me-1"></i> Back</a>
        <h4 class="mt-2 mb-0" style="color: var(--text-primary);">@Model.Subject</h4>
        <small style="color: var(--text-secondary);">
            <span class="badge @(Model.Channel.ToString() switch { "Chat" => "bg-primary", "Voice" => "bg-success", "Sms" => "bg-warning", "Email" => "bg-danger", _ => "bg-secondary" })">@Model.Channel</span>
            @if (Model.Contact != null) { <span>with @Model.Contact.Name</span> }
            &middot; @Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")
        </small>
    </div>
</div>

<!-- Chat Messages Area -->
<div class="card border-0 shadow-sm">
    <div class="card-body chat-area" id="chatArea" style="height: 500px; overflow-y: auto;">
        @foreach (var msg in Model.Messages)
        {
            var isOutbound = msg.Direction == MessageDirection.Outbound;
            <div class="d-flex @(isOutbound ? "justify-content-end" : "justify-content-start") mb-2">
                <div class="chat-bubble @(isOutbound ? "chat-bubble-outbound" : "chat-bubble-inbound")">
                    <div style="white-space: pre-wrap;">@msg.Body</div>
                    <div class="chat-bubble-time">@msg.CreatedAt.ToString("HH:mm")</div>
                </div>
            </div>
        }
    </div>

    @if (Model.Channel == ChannelType.Chat)
    {
        <div class="card-footer">
            <div class="input-group">
                <input type="text" class="form-control" id="messageInput" placeholder="Type a message..." />
                <button class="btn btn-primary" id="sendBtn">
                    <i class="bi bi-send"></i> Send
                </button>
            </div>
        </div>
    }
</div>

<!-- Channel Metadata -->
@if (Model.CallLogs.Any())
{
    <div class="card border-0 shadow-sm mt-3">
        <div class="card-header">Call Details</div>
        <div class="card-body">
            @foreach (var log in Model.CallLogs)
            {
                <p style="color: var(--text-secondary);"><strong style="color: var(--text-primary);">SID:</strong> @log.CallSid &middot; <strong style="color: var(--text-primary);">From:</strong> @log.From &middot; <strong style="color: var(--text-primary);">To:</strong> @log.To &middot; <strong style="color: var(--text-primary);">Status:</strong> @log.Status &middot; <strong style="color: var(--text-primary);">Duration:</strong> @(log.DurationSeconds?.ToString() ?? "—")s</p>
            }
        </div>
    </div>
}

@if (Model.SmsRecords.Any())
{
    <div class="card border-0 shadow-sm mt-3">
        <div class="card-header">SMS Details</div>
        <div class="card-body">
            @foreach (var sms in Model.SmsRecords)
            {
                <p style="color: var(--text-secondary);"><strong style="color: var(--text-primary);">SID:</strong> @sms.MessageSid &middot; <strong style="color: var(--text-primary);">From:</strong> @sms.From &middot; <strong style="color: var(--text-primary);">To:</strong> @sms.To &middot; <strong style="color: var(--text-primary);">Status:</strong> @sms.Status</p>
            }
        </div>
    </div>
}

@if (Model.EmailRecords.Any())
{
    <div class="card border-0 shadow-sm mt-3">
        <div class="card-header">Email Details</div>
        <div class="card-body">
            @foreach (var email in Model.EmailRecords)
            {
                <p style="color: var(--text-secondary);"><strong style="color: var(--text-primary);">From:</strong> @email.FromEmail &middot; <strong style="color: var(--text-primary);">To:</strong> @email.ToEmail &middot; <strong style="color: var(--text-primary);">Subject:</strong> @email.SubjectLine &middot; <strong style="color: var(--text-primary);">Status:</strong> @email.Status</p>
            }
        </div>
    </div>
}

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
<script>
    const conversationId = @Model.Id;
    const chatArea = document.getElementById('chatArea');
    const messageInput = document.getElementById('messageInput');
    const sendBtn = document.getElementById('sendBtn');

    chatArea.scrollTop = chatArea.scrollHeight;

    const connection = new signalR.HubConnectionBuilder()
        .withUrl('/chatHub')
        .withAutomaticReconnect()
        .build();

    connection.on('ReceiveMessage', (data) => {
        if (data.userMessage) appendMessage(data.userMessage.body, false);
        if (data.aiMessage) appendMessage(data.aiMessage.body, true);
    });

    connection.start().then(() => {
        connection.invoke('JoinConversation', conversationId.toString());
    });

    function appendMessage(text, isAi) {
        const div = document.createElement('div');
        div.className = `d-flex ${isAi ? 'justify-content-end' : 'justify-content-start'} mb-2`;
        div.innerHTML = `<div class="chat-bubble ${isAi ? 'chat-bubble-outbound' : 'chat-bubble-inbound'}" style="white-space: pre-wrap;">${escapeHtml(text)}</div>`;
        chatArea.appendChild(div);
        chatArea.scrollTop = chatArea.scrollHeight;
    }

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    if (sendBtn) {
        async function sendMessage() {
            const msg = messageInput.value.trim();
            if (!msg) return;
            messageInput.value = '';
            sendBtn.disabled = true;
            appendMessage(msg, false);
            try {
                const res = await fetch(`/api/chat/conversations/${conversationId}/messages`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: msg })
                });
                const data = await res.json();
                appendMessage(data.aiMessage.body, true);
            } catch (e) {
                appendMessage('Error: Could not get AI response.', true);
            }
            sendBtn.disabled = false;
            messageInput.focus();
        }

        sendBtn.addEventListener('click', sendMessage);
        messageInput.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') sendMessage();
        });
    }
</script>
}
